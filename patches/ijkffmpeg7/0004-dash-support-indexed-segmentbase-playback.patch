+static int download_fragment(struct representation *pls, struct fragment *seg,
+                             uint8_t **buffer, unsigned int *buffer_size,
+                             uint32_t *data_len, int max_size)
+{
+    DASHContext *c = pls->parent->priv_data;
+    int64_t expected_size;
+    int64_t url_size;
+    int total = 0;
+    int ret;
+
+    ret = open_input(c, pls, seg, 1);
+    if (ret < 0)
+        return ret;
+
+    if (seg->size >= 0)
+        expected_size = seg->size;
+    else if ((url_size = avio_size(pls->input)) >= 0)
+        expected_size = url_size - seg->url_offset;
+    else
+        expected_size = max_size;
+
+    if (expected_size <= 0 || expected_size > max_size) {
+        ret = AVERROR_INVALIDDATA;
+        goto done;
+    }
+
+    av_fast_malloc(buffer, buffer_size, expected_size);
+    if (!*buffer) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+
+    while (total < expected_size) {
+        ret = read_from_url(pls, seg, *buffer + total, expected_size - total);
+        if (ret > 0) {
+            total += ret;
+            continue;
+        }
+        if (ret == AVERROR_EOF && seg->size < 0)
+            break;
+        goto done;
+    }
+
+    if (seg->size >= 0 && total != seg->size) {
+        ret = AVERROR_INVALIDDATA;
+        goto done;
+    }
+
+    *data_len = total;
+    ret = 0;
+
+done:
+    ff_format_io_close(pls->parent, &pls->input);
+    return ret;
+}
