 static struct fragment * get_Fragment(char *range)
 {
-    struct fragment * seg =  av_mallocz(sizeof(struct fragment));
+    struct fragment *seg = av_mallocz(sizeof(*seg));
 
     if (!seg)
         return NULL;
 
     seg->size = -1;
     if (range) {
-        char *str_end_offset;
+        char *str_end_offset = NULL;
         char *str_offset = av_strtok(range, "-", &str_end_offset);
-        seg->url_offset = strtoll(str_offset, NULL, 10);
-        seg->size = strtoll(str_end_offset, NULL, 10) - seg->url_offset + 1;
+        char *tail = NULL;
+        int64_t end_offset;
+
+        if (!str_offset || !str_end_offset || !*str_end_offset)
+            goto invalid;
+
+        errno = 0;
+        seg->url_offset = strtoll(str_offset, &tail, 10);
+        if (errno || tail == str_offset || *tail || seg->url_offset < 0)
+            goto invalid;
+
+        errno = 0;
+        end_offset = strtoll(str_end_offset, &tail, 10);
+        if (errno || tail == str_end_offset || *tail ||
+            end_offset < seg->url_offset || end_offset == INT64_MAX)
+            goto invalid;
+
+        seg->size = end_offset - seg->url_offset + 1;
     }
 
     return seg;
+
+invalid:
+    av_free(seg);
+    return NULL;
+}
