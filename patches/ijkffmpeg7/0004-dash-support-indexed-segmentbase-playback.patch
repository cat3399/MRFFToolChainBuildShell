+static int parse_segmentbase_sidx(AVFormatContext *s, struct representation *rep,
+                                  struct fragment *media,
+                                  const uint8_t *data, int data_size,
+                                  int64_t data_file_offset)
+{
+    const uint8_t *p = data;
+    const uint8_t *end = data + data_size;
+    struct representation parsed_index = { 0 };
+    char *media_url = NULL;
+    int ret = 0;
+
+    if (!rep || !media || !media->url || !data || data_size < 8 ||
+        data_file_offset < 0)
+        return AVERROR(EINVAL);
+
+    while (p + 8 <= end) {
+        uint64_t box_size = AV_RB32(p);
+        uint32_t box_type = AV_RB32(p + 4);
+        int header_size = 8;
+        const uint8_t *box_end;
+        const uint8_t *q;
+        uint32_t version;
+        uint32_t timescale;
+        uint16_t reference_count;
+        uint64_t earliest_presentation_time;
+        uint64_t first_offset;
+        int64_t sidx_file_offset;
+        int64_t offset;
+        int64_t first_media_offset;
+        int i;
+
+        if (box_size == 1) {
+            if (p + 16 > end)
+                return AVERROR_INVALIDDATA;
+            box_size = AV_RB64(p + 8);
+            header_size = 16;
+        } else if (box_size == 0) {
+            box_size = end - p;
+        }
+
+        if (box_size < header_size || box_size > (uint64_t)(end - p))
+            return AVERROR_INVALIDDATA;
+        box_end = p + (size_t)box_size;
+
+        if (box_type != MKBETAG('s', 'i', 'd', 'x')) {
+            p = box_end;
+            continue;
+        }
+
+        q = p + header_size;
+        if (q + 12 > box_end)
+            return AVERROR_INVALIDDATA;
+
+        version = q[0];
+        if (version > 1)
+            return AVERROR_INVALIDDATA;
+        q += 4; /* version + flags */
+        q += 4; /* reference_ID */
+        timescale = AV_RB32(q);
+        q += 4;
+        if (!timescale)
+            return AVERROR_INVALIDDATA;
+
+        if (version == 0) {
+            if (q + 8 > box_end)
+                return AVERROR_INVALIDDATA;
+            earliest_presentation_time = AV_RB32(q);
+            q += 4;
+            first_offset = AV_RB32(q);
+            q += 4;
+        } else {
+            if (q + 16 > box_end)
+                return AVERROR_INVALIDDATA;
+            earliest_presentation_time = AV_RB64(q);
+            q += 8;
+            first_offset = AV_RB64(q);
+            q += 8;
+        }
+
+        if (q + 4 > box_end || earliest_presentation_time > INT64_MAX)
+            return AVERROR_INVALIDDATA;
+        q += 2; /* reserved */
+        reference_count = AV_RB16(q);
+        q += 2;
+        if (!reference_count || (uint64_t)(box_end - q) < (uint64_t)reference_count * 12)
+            return AVERROR_INVALIDDATA;
+
+        media_url = av_strdup(media->url);
+        if (!media_url)
+            return AVERROR(ENOMEM);
+
+        if (p - data > INT64_MAX - data_file_offset ||
+            box_size > INT64_MAX - (data_file_offset + (p - data))) {
+            ret = AVERROR_INVALIDDATA;
+            goto fail;
+        }
+        sidx_file_offset = data_file_offset + (p - data);
+        offset = sidx_file_offset + box_size;
+        if (first_offset > INT64_MAX - offset) {
+            ret = AVERROR_INVALIDDATA;
+            goto fail;
+        }
+        offset += first_offset;
+        first_media_offset = offset;
+
+        for (i = 0; i < reference_count; i++) {
+            uint32_t ref = AV_RB32(q);
+            uint32_t duration = AV_RB32(q + 4);
+            struct fragment *seg = NULL;
+            struct timeline *tml = NULL;
+            uint32_t reference_size = ref & 0x7fffffff;
+
+            q += 12;
+            if (ref & 0x80000000) {
+                ret = AVERROR_PATCHWELCOME;
+                goto fail;
+            }
+            if (!reference_size || !duration || reference_size > INT64_MAX - offset) {
+                ret = AVERROR_INVALIDDATA;
+                goto fail;
+            }
+
+            seg = av_mallocz(sizeof(*seg));
+            tml = av_mallocz(sizeof(*tml));
+            if (!seg || !tml) {
+                free_fragment(&seg);
+                av_freep(&tml);
+                ret = AVERROR(ENOMEM);
+                goto fail;
+            }
+            seg->url = av_strdup(media_url);
+            if (!seg->url) {
+                free_fragment(&seg);
+                av_freep(&tml);
+                ret = AVERROR(ENOMEM);
+                goto fail;
+            }
+            seg->url_offset = offset;
+            seg->size = reference_size;
+            if (!i)
+                tml->starttime = earliest_presentation_time;
+            tml->duration = duration;
+            tml->repeat = 0;
+
+            ret = av_dynarray_add_nofree(&parsed_index.fragments,
+                                         &parsed_index.n_fragments, seg);
+            if (ret < 0) {
+                free_fragment(&seg);
+                av_freep(&tml);
+                goto fail;
+            }
+            ret = av_dynarray_add_nofree(&parsed_index.timelines,
+                                         &parsed_index.n_timelines, tml);
+            if (ret < 0) {
+                av_freep(&tml);
+                goto fail;
+            }
+            offset += reference_size;
+        }
+
+        free_fragment_list(rep);
+        free_timelines_list(rep);
+        rep->fragments = parsed_index.fragments;
+        rep->n_fragments = parsed_index.n_fragments;
+        rep->timelines = parsed_index.timelines;
+        rep->n_timelines = parsed_index.n_timelines;
+        parsed_index.fragments = NULL;
+        parsed_index.n_fragments = 0;
+        parsed_index.timelines = NULL;
+        parsed_index.n_timelines = 0;
+        rep->fragment_timescale = timescale;
+        rep->first_seq_no = 0;
+        rep->last_seq_no = rep->n_fragments - 1;
+        rep->is_segmentbase_sidx = 1;
+        av_log(s, AV_LOG_VERBOSE,
+               "DASH SegmentBase parsed sidx refs=%d timescale=%u media [%"PRId64",%"PRId64"], representation %s\n",
+               rep->n_fragments, timescale, first_media_offset, offset - 1,
+               rep->id ? rep->id : "");
+        av_freep(&media_url);
+        return rep->n_fragments;
+    }
+
+    return AVERROR_INVALIDDATA;
+
+fail:
+    av_freep(&media_url);
+    free_fragment_list(&parsed_index);
+    free_timelines_list(&parsed_index);
+    return ret;
 }
 
