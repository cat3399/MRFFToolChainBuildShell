From 0ff19eb7bc8aca9801fdb72c4b05d3a94e75f3ca Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 1 Sep 2026 21:21:13 +0800
Subject: [PATCH] avformat/dash: coalesce adjacent SegmentBase metadata ranges

---
 libavformat/dashdec.c | 180 +++++++++++++++++++++++++++++++++++-------
 1 file changed, 153 insertions(+), 27 deletions(-)

diff --git a/libavformat/dashdec.c b/libavformat/dashdec.c
index 587088a..7d66c3a 100644
--- a/libavformat/dashdec.c
+++ b/libavformat/dashdec.c
@@ -2220,9 +2220,13 @@ done:
     return ret;
 }
 
+enum {
+    MAX_DASH_INIT_SECTION_SIZE  = 1024 * 1024,
+    MAX_DASH_INDEX_SECTION_SIZE = 1024 * 1024,
+};
+
 static int update_init_section(struct representation *pls)
 {
-    static const int max_init_section_size = 1024 * 1024;
     int ret;
 
     if (!pls->init_section || pls->init_sec_buf)
@@ -2230,7 +2234,8 @@ static int update_init_section(struct representation *pls)
 
     ret = download_fragment(pls, pls->init_section,
                             &pls->init_sec_buf, &pls->init_sec_buf_size,
-                            &pls->init_sec_data_len, max_init_section_size);
+                            &pls->init_sec_data_len,
+                            MAX_DASH_INIT_SECTION_SIZE);
     if (ret < 0) {
         av_log(pls->parent, AV_LOG_ERROR,
                "Failed to read complete DASH initialization section\n");
@@ -2241,10 +2246,36 @@ static int update_init_section(struct representation *pls)
     return 0;
 }
 
-static int update_segmentbase_index(struct representation *pls)
+static int apply_segmentbase_index(struct representation *pls,
+                                   const uint8_t *index_data,
+                                   uint32_t index_data_len)
 {
-    static const int max_index_section_size = 1024 * 1024;
     struct fragment *media;
+    int ret;
+
+    if (!pls->index_section || pls->n_fragments != 1 ||
+        !pls->fragments[0] || !index_data || !index_data_len)
+        return AVERROR_INVALIDDATA;
+
+    media = pls->fragments[0];
+    ret = parse_segmentbase_sidx(pls->parent, pls, media,
+                                 index_data, index_data_len,
+                                 pls->index_section->url_offset);
+    if (ret <= 0)
+        return ret ? ret : AVERROR_INVALIDDATA;
+
+    free_fragment(&pls->cur_seg);
+    if (pls->cur_seq_no < pls->first_seq_no)
+        pls->cur_seq_no = pls->first_seq_no;
+    if (pls->cur_seq_no > pls->last_seq_no)
+        pls->cur_seq_no = pls->last_seq_no;
+    pls->segmentbase_index_parsed = 1;
+
+    return 0;
+}
+
+static int update_segmentbase_index(struct representation *pls)
+{
     uint8_t *index_buf = NULL;
     unsigned int index_buf_size = 0;
     uint32_t index_data_len = 0;
@@ -2252,38 +2283,136 @@ static int update_segmentbase_index(struct representation *pls)
 
     if (!pls->index_section || pls->segmentbase_index_parsed)
         return 0;
-    if (pls->n_fragments != 1 || !pls->fragments[0])
-        return AVERROR_INVALIDDATA;
 
-    media = pls->fragments[0];
     ret = download_fragment(pls, pls->index_section,
                             &index_buf, &index_buf_size, &index_data_len,
-                            max_index_section_size);
+                            MAX_DASH_INDEX_SECTION_SIZE);
     if (ret < 0)
         goto done;
 
-    ret = parse_segmentbase_sidx(pls->parent, pls, media,
-                                 index_buf, index_data_len,
-                                 pls->index_section->url_offset);
-    if (ret <= 0) {
-        if (!ret)
-            ret = AVERROR_INVALIDDATA;
+    ret = apply_segmentbase_index(pls, index_buf, index_data_len);
+
+done:
+    av_freep(&index_buf);
+    return ret;
+}
+
+static int get_merged_segmentbase_range(struct representation *pls,
+                                        int64_t *merged_offset,
+                                        int64_t *merged_size)
+{
+    const struct fragment *init = pls->init_section;
+    const struct fragment *index = pls->index_section;
+    int64_t init_end;
+    int64_t index_end;
+    int64_t range_end;
+
+    if (!init || !index || !init->url || !index->url ||
+        pls->init_sec_buf || pls->segmentbase_index_parsed ||
+        strcmp(init->url, index->url))
+        return 0;
+
+    if (init->url_offset < 0 || index->url_offset < 0 ||
+        init->size <= 0 || index->size <= 0 ||
+        init->size > MAX_DASH_INIT_SECTION_SIZE ||
+        index->size > MAX_DASH_INDEX_SECTION_SIZE ||
+        init->url_offset > INT64_MAX - init->size ||
+        index->url_offset > INT64_MAX - index->size)
+        return 0;
+
+    init_end = init->url_offset + init->size;
+    index_end = index->url_offset + index->size;
+    if (init_end == index->url_offset) {
+        *merged_offset = init->url_offset;
+        range_end = index_end;
+    } else if (index_end == init->url_offset) {
+        *merged_offset = index->url_offset;
+        range_end = init_end;
+    } else {
+        return 0;
+    }
+
+    *merged_size = range_end - *merged_offset;
+    return *merged_size > 0 &&
+           *merged_size <= MAX_DASH_INIT_SECTION_SIZE +
+                           MAX_DASH_INDEX_SECTION_SIZE;
+}
+
+static int update_merged_segmentbase_sections(struct representation *pls,
+                                              int64_t merged_offset,
+                                              int64_t merged_size)
+{
+    struct fragment merged = { 0 };
+    uint8_t *merged_buf = NULL;
+    unsigned int merged_buf_size = 0;
+    uint32_t merged_data_len = 0;
+    int64_t init_data_offset;
+    int64_t index_data_offset;
+    int ret;
+
+    merged.url = pls->init_section->url;
+    merged.url_offset = merged_offset;
+    merged.size = merged_size;
+    ret = download_fragment(pls, &merged, &merged_buf, &merged_buf_size,
+                            &merged_data_len,
+                            MAX_DASH_INIT_SECTION_SIZE +
+                            MAX_DASH_INDEX_SECTION_SIZE);
+    if (ret < 0)
+        goto done;
+
+    init_data_offset = pls->init_section->url_offset - merged_offset;
+    index_data_offset = pls->index_section->url_offset - merged_offset;
+    if (init_data_offset < 0 || index_data_offset < 0 ||
+        init_data_offset > merged_data_len ||
+        index_data_offset > merged_data_len ||
+        pls->init_section->size > merged_data_len - init_data_offset ||
+        pls->index_section->size > merged_data_len - index_data_offset) {
+        ret = AVERROR_INVALIDDATA;
         goto done;
     }
 
-    free_fragment(&pls->cur_seg);
-    if (pls->cur_seq_no < pls->first_seq_no)
-        pls->cur_seq_no = pls->first_seq_no;
-    if (pls->cur_seq_no > pls->last_seq_no)
-        pls->cur_seq_no = pls->last_seq_no;
-    pls->segmentbase_index_parsed = 1;
-    ret = 0;
+    av_fast_malloc(&pls->init_sec_buf, &pls->init_sec_buf_size,
+                   pls->init_section->size);
+    if (!pls->init_sec_buf) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+    memcpy(pls->init_sec_buf, merged_buf + init_data_offset,
+           pls->init_section->size);
+    pls->init_sec_data_len = pls->init_section->size;
+    pls->init_sec_buf_read_offset = 0;
+
+    ret = apply_segmentbase_index(pls, merged_buf + index_data_offset,
+                                  pls->index_section->size);
+    if (ret < 0)
+        goto done;
+
+    av_log(pls->parent, AV_LOG_VERBOSE,
+           "DASH merged adjacent initialization and index ranges: "
+           "representation=%s offset=%"PRId64" size=%"PRId64"\n",
+           pls->id ? pls->id : "", merged_offset, merged_size);
 
 done:
-    av_freep(&index_buf);
+    av_freep(&merged_buf);
     return ret;
 }
 
+static int update_segmentbase_sections(struct representation *pls)
+{
+    int64_t merged_offset;
+    int64_t merged_size;
+    int ret;
+
+    if (get_merged_segmentbase_range(pls, &merged_offset, &merged_size))
+        return update_merged_segmentbase_sections(pls, merged_offset,
+                                                  merged_size);
+
+    ret = update_init_section(pls);
+    if (ret < 0)
+        return ret;
+    return update_segmentbase_index(pls);
+}
+
 static int is_single_full_fragment_representation(struct representation *pls)
 {
     return pls &&
@@ -2360,11 +2489,8 @@ static int read_data(void *opaque, uint8_t *buf, int buf_size)
 
 restart:
     if (!v->input) {
-        /* load/update Media Initialization Section, if any */
-        ret = update_init_section(v);
-        if (ret)
-            goto end;
-        ret = update_segmentbase_index(v);
+        /* Coalesce adjacent initialization and SegmentBase index ranges. */
+        ret = update_segmentbase_sections(v);
         if (ret)
             goto end;
 
-- 
2.47.3

