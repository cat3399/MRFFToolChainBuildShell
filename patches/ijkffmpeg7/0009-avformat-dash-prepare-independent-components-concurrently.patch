+/* The callback outlives the preparation workers: persistent HTTP contexts
+ * retain it during playback. Never point an AVIO callback at a stack job. */
+static int dash_io_interrupt(void *opaque)
+{
+    DASHContext *c = opaque;
+
+    return atomic_load(&c->preparation_error) < 0 ||
+           ff_check_interrupt(c->interrupt_callback);
+}
+
+static void fail_preparation(DASHContext *c, int error)
+{
+    int expected = 0;
+
+    /* Preserve the original failure; peers interrupted by it report EXIT. */
+    atomic_compare_exchange_strong(&c->preparation_error, &expected, error);
+}
