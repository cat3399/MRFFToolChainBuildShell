+static int copy_io_options(DASHContext *c, AVDictionary **dst,
+                           const AVDictionary *request_options)
+{
+    int ret;
+
+    /* Only the shared option/cookie snapshot is locked, never network I/O. */
+    ff_mutex_lock(&c->avio_opts_mutex);
+    ret = av_dict_copy(dst, c->avio_opts, 0);
+    ff_mutex_unlock(&c->avio_opts_mutex);
+    if (ret < 0)
+        return ret;
+    return av_dict_copy(dst, request_options, 0);
+}
