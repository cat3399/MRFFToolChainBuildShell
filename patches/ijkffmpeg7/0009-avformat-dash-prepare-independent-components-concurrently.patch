         AVStream *st = avformat_new_stream(s, NULL);
@@ -2910,6 +2953,106 @@ static int copy_init_section(struct representation *rep_dest, struct representat
     return 0;
 }
 
+typedef struct DASHPreparation {
+    AVFormatContext *parent;
+    struct representation **representations;
+    int count;
+    const char *type;
+} DASHPreparation;
+
+static void *prepare_component_group(void *opaque)
+{
+    DASHPreparation *job = opaque;
+    DASHContext *c = job->parent->priv_data;
+    int common_init, i, ret = 0;
+    int64_t started = av_gettime_relative();
+
+    if (!job->count)
+        return NULL;
+
+    common_init = is_common_init_section_exist(job->representations, job->count);
+    for (i = 0; i < job->count; i++) {
+        struct representation *rep = job->representations[i];
+
+        if (ff_check_interrupt(&c->io_interrupt_callback)) {
+            ret = AVERROR_EXIT;
+            break;
+        }
+        /* Representations sharing initialization stay ordered within their
+         * group; independent media types can prepare concurrently. */
+        if (i && common_init) {
+            ret = copy_init_section(rep, job->representations[0]);
+            if (ret < 0)
+                break;
+        }
+        ret = prepare_component(job->parent, rep);
+        if (ret < 0)
+            break;
+    }
+    if (ret < 0)
+        fail_preparation(c, ret);
+    av_log(job->parent, AV_LOG_INFO,
+           "DASHSTART stage=prepare_group type=%s elapsed_us=%"PRId64
+           " representations=%d ret=%d\n",
+           job->type, av_gettime_relative() - started, job->count, ret);
+    return NULL;
+}
+
+static int prepare_components(AVFormatContext *s)
+{
+    DASHContext *c = s->priv_data;
+    DASHPreparation jobs[] = {
+        { s, c->videos,    c->n_videos,    "video" },
+        { s, c->audios,    c->n_audios,    "audio" },
+        { s, c->subtitles, c->n_subtitles, "subtitle" },
+    };
+    int i, parallel = 0, ret;
+    int64_t started = av_gettime_relative();
+#if HAVE_THREADS
+    pthread_t threads[FF_ARRAY_ELEMS(jobs)];
+    int launched[FF_ARRAY_ELEMS(jobs)] = { 0 };
+    int active = !!c->n_videos + !!c->n_audios + !!c->n_subtitles;
+
+    /* VOD's manifest is immutable here. Live input can refresh that shared
+     * manifest while opening a component, so it uses the same jobs in order. */
+    parallel = !c->is_live && active > 1;
+    if (parallel) {
+        for (i = 1; i < FF_ARRAY_ELEMS(jobs); i++) {
+            if (!jobs[i].count)
+                continue;
+            ret = pthread_create(&threads[i], NULL, prepare_component_group,
+                                  &jobs[i]);
+            if (ret) {
+                fail_preparation(c, AVERROR(ret));
+                break;
+            }
+            launched[i] = 1;
+        }
+        prepare_component_group(&jobs[0]);
+        /* No job or its AVIO may outlive read_header, on success or error. */
+        for (i = 1; i < FF_ARRAY_ELEMS(jobs); i++) {
+            if (launched[i])
+                pthread_join(threads[i], NULL);
+        }
+    } else
+#endif
+    {
+        for (i = 0; i < FF_ARRAY_ELEMS(jobs); i++) {
+            prepare_component_group(&jobs[i]);
+            if (atomic_load(&c->preparation_error) < 0)
+                break;
+        }
+    }
+    if (ff_check_interrupt(c->interrupt_callback))
+        fail_preparation(c, AVERROR_EXIT);
+    ret = atomic_load(&c->preparation_error);
+    av_log(s, AV_LOG_INFO,
+           "DASHSTART stage=prepare_components elapsed_us=%"PRId64
+           " parallel=%d ret=%d\n",
+           av_gettime_relative() - started, parallel, ret);
+    return ret;
+}
